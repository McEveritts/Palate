// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  Male
  Female
  Other
}

enum ActivityLevel {
  Sedentary
  Light
  Moderate
  Active
  VeryActive
}

enum Goal {
  Lose
  Maintain
  Gain
}

enum MealType {
  Breakfast
  Lunch
  Dinner
  Snack
}

enum ChatRole {
  user
  model
}

model Household {
  id          String       @id @default(cuid())
  name        String       // e.g. "The McEveritts' Kitchen"
  members     User[]
  recipes     Recipe[]
  inviteCodes InviteCode[]
  createdAt   DateTime     @default(now())
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique // 8-char hex
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   String    // userId of the inviter
  expiresAt   DateTime  // 48h from creation
  usedAt      DateTime? // null until redeemed
  usedBy      String?   // userId of the redeemer
}

model User {
  id            String          @id @default(cuid())
  email         String?         @unique
  name          String?
  image         String?
  emailVerified DateTime?
  
  // Household membership
  householdId   String?
  household     Household?      @relation(fields: [householdId], references: [id], onDelete: SetNull)

  // Relations
  config           UserConfig?
  jellyfinIdentity JellyfinIdentity?
  chatSessions     ChatSession[]
  schedule         ScheduledMeal[]
  accounts         Account[]
  sessions         Session[]
  profile          UserProfile?
  dailyLogs        DailyLog[]
  weightLogs       WeightLog[]
  fastingLogs      FastingLog[]
  
  createdAt     DateTime        @default(now())
}

model JellyfinIdentity {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jellyfinUserId      String
  jellyfinServerId    String
  jellyfinUsername    String
  lastAuthenticatedAt DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([jellyfinServerId, jellyfinUserId])
  @@index([jellyfinUserId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Cryptographic Storage for Google Cloud / Gemma-4 Keys
  encryptedGcpKey   String?  // AES-256-GCM encrypted string
  authTag           String?  // GCM Auth Tag for integrity verification
  iv                String?  // Initialization Vector
  
  metricSystem      Boolean  @default(false)

  // Google Calendar Integration
  googleCalendarId  String?
  googleCalendarSyncEnabled Boolean @default(false)
}

model Recipe {
  id              String   @id @default(cuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  slug            String
  title           String
  markdown        String   // Recipe content
  frontmatter     Json     // Macros, USDA status, tags
  cooklangAST     Json?    // Compiled AST for rapid scalar multiplication
  totalMacros     Json?    // Cached [P, C, F, Kcal] vector
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  scheduledMeals  ScheduledMeal[]
  logEntries      FoodLogEntry[]
  
  @@unique([householdId, slug]) // Enforces unique recipe names per household
}

model ScheduledMeal {
  id            String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recipeId      String
  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  date          DateTime // The specific day on the calendar
  mealType      MealType
  plannedYield  Float    @default(1.0) // E.g., eating 2 portions of an 8-portion meal
  
  // Self-relations for parentMealId (DAG for leftovers/batch cooking)
  parentMealId  String?
  parentMeal    ScheduledMeal?   @relation("MealDAG", fields: [parentMealId], references: [id], onDelete: Cascade)
  childMeals    ScheduledMeal[]  @relation("MealDAG")

  // Google Calendar integration
  googleEventId String?

  @@index([userId, date])
}

model ChatSession {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String        // Auto-generated by AI (e.g., "Sunday Meal Prep")
  messages    ChatMessage[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          ChatRole
  content       String      // The message text
  thought       String?     // Preserved Gemma-4 <thought> blocks
  
  createdAt     DateTime    @default(now())

  @@index([sessionId])
}

// ---------------------------------------------------------
// INDIVIDUAL SCOPE (Physiological Telemetry)
// ---------------------------------------------------------
model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Anthropometric Vectors
  gender          Gender   
  dateOfBirth     DateTime 
  weightKg        Float    // Current weight for TDEE calculation, synced from latest WeightLog
  heightCm        Float
  activityLevel   ActivityLevel   
  goal            Goal   
  
  // Computed Target Matrices
  targetCalories  Int
  targetProtein   Int      
  targetCarbs     Int      
  targetFat       Int      
  targetWaterMl   Int      @default(1893)  // ~64 oz daily hydration goal

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WeightLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt      DateTime @default(now())
  weightKg        Float
  createdAt       DateTime @default(now())

  @@index([userId, measuredAt])
}

model DailyLog {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime       @db.Date // Ensures strict temporal mapping
  
  // Aggregated Vectors (Maintained by triggers/hooks for fast read)
  totalCalories   Float          @default(0)
  totalProtein    Float          @default(0)
  totalCarbs      Float          @default(0)
  totalFat        Float          @default(0)
  totalFiber      Float          @default(0)
  totalSugar      Float          @default(0)
  totalSodium     Float          @default(0)
  waterIntakeMl   Int            @default(0)  // Aggregated daily water intake in ml
  
  entries         FoodLogEntry[]
  exerciseEntries ExerciseLogEntry[]
  waterEntries    WaterLogEntry[]

  @@unique([userId, date]) // A user can only have one master log per day
}

model FoodLogEntry {
  id              String   @id @default(cuid())
  dailyLogId      String
  dailyLog        DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  mealType        MealType
  timestamp       DateTime @default(now()) // High-resolution temporal tracking
  createdAt       DateTime @default(now())
  
  // Optional link to the Household culinary graph
  recipeId        String?  
  recipe          Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  
  customFoodName  String?  
  amountConsumed  Float    // Scalar multiplier (y)
  
  // Immutable snapshot of macros at time of consumption
  calories        Float
  protein         Float
  carbs           Float
  fat             Float
  fiber           Float    @default(0)
  sugar           Float    @default(0)
  sodium          Float    @default(0)

  @@index([dailyLogId])
}

model ExerciseLogEntry {
  id              String   @id @default(cuid())
  dailyLogId      String
  dailyLog        DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  exerciseName    String
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())
  
  durationMinutes Int
  caloriesBurned  Float
  
  @@index([dailyLogId])
}

model WaterLogEntry {
  id          String   @id @default(cuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  
  amountMl    Int       // Amount logged in millilitres
  timestamp   DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([dailyLogId])
}

model FastingLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime   DateTime  @default(now())
  endTime     DateTime?
  targetHours Int       @default(16)
  completed   Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, startTime])
}

// ---------------------------------------------------------
// AUTHENTICATION RATE LIMITING (PostgreSQL Concurrency-Safe)
// ---------------------------------------------------------
model AuthRateLimit {
  key       String     @id // HMAC-SHA256 derived identifier
  attempts  DateTime[]    // Bounded list of attempt timestamps in rolling window
  expiresAt DateTime      // Indexed expiration timestamp for bounded cleanup
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([expiresAt])
}
